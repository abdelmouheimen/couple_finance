# Production settings, on the server only: /opt/couplefinance/.env (mode 600, never committed).
# init-env.sh creates it from these public values and generates every secret below that is left empty.

# Public URLs and mail identity (replace example.com by the real domain).
RECEIPT_PUBLIC_ENDPOINT=https://files.example.com
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
MAIL_FROM=CoupleFinance <no-reply@example.com>
DKIM_SELECTOR=couplefinance
BACKEND_PORT=8091

# Secrets: generated by init-env.sh.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=couplefinance
MINIO_ROOT_PASSWORD=
MINIO_KMS_SECRET_KEY=
CURSOR_KEY=
JWT_SIGNING_JWK=

# Written by deploy.sh: image currently deployed.
IMAGE_TAG=
