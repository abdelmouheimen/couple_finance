# Copy to infra/.env to override the local development defaults. Never commit infra/.env.
# The backend `local` profile reads the same variable names.
POSTGRES_DB=couplefinance
POSTGRES_USER=couplefinance
POSTGRES_PASSWORD=couplefinance
POSTGRES_PORT=5432
MINIO_ROOT_USER=couplefinance
MINIO_ROOT_PASSWORD=couplefinance-dev
# keyname:base64 of 32 random bytes, e.g. couplefinance-dev:<output of openssl rand -base64 32>
MINIO_KMS_SECRET_KEY=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
CLAMAV_PORT=3310
