{
  "name": "couplefinance-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/shared/api/generated/schema.d.ts && prettier --write src/shared/api/generated/schema.d.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- src/shared/api/generated",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "expo": "^57.0.26",
    "expo-constants": "^57.0.20",
    "expo-linking": "^57.0.11",
    "expo-router": "^57.0.24",
    "expo-secure-store": "^57.0.4",
    "expo-status-bar": "^57.0.1",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "test-renderer": "^1.3.0",
    "typescript": "~5.9.3"
  }
}
